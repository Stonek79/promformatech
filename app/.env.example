# Local development only. pnpm env:init generates both passwords automatically.
POSTGRES_DB=promformatech
POSTGRES_USER=promformatech
POSTGRES_PASSWORD=replace-with-generated-database-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://promformatech:replace-with-generated-database-password@127.0.0.1:5433/promformatech
PAYLOAD_SECRET=replace-with-generated-payload-secret
SERVER_URL=http://localhost:3000
