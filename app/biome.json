{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!pnpm-lock.yaml",
			"!.next-e2e",
			"!src/design-system/generated",
			"!src/migrations/*.json",
			"!src/app/(payload)/admin/importMap.js"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": { "useBlockStatements": "error" },
			"suspicious": { "noExplicitAny": "error" }
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["src/**/*.ts", "src/**/*.tsx"],
			"linter": { "rules": { "style": { "noMagicNumbers": "error" } } }
		}
	]
}
