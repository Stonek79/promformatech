{
	"name": "app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "pnpm prepare:app && next dev --turbopack --hostname 127.0.0.1",
		"build": "pnpm prepare:app && next build --turbopack",
		"start": "next start",
		"lint": "biome check . && node scripts/check-code-structure.mjs",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "next typegen && tsc --noEmit",
		"env:init": "node scripts/init-env.mjs",
		"db:up": "docker compose up -d --wait postgres",
		"db:down": "docker compose down",
		"db:logs": "docker compose logs -f postgres",
		"payload": "payload",
		"payload:types": "node scripts/generate-payload-types.mjs",
		"payload:importmap": "payload generate:importmap",
		"tokens:build": "node scripts/generate-tokens.mjs",
		"prepare:app": "pnpm tokens:build && pnpm payload:types && pnpm payload:importmap",
		"seed": "payload run src/cms/scripts/seed.ts",
		"worker": "payload run src/cms/scripts/worker.ts",
		"worker:once": "payload run src/cms/scripts/worker.ts once",
		"cms:create-owner": "payload run src/cms/scripts/create-owner.ts",
		"lint:css": "stylelint \"src/**/*.css\" && node scripts/check-design-tokens.mjs",
		"test": "vitest run",
		"check": "pnpm lint && pnpm typecheck && pnpm lint:css && pnpm test",
		"test:e2e": "node scripts/run-e2e.mjs",
		"cms:cleanup": "payload run src/cms/scripts/cleanup.ts",
		"test:media": "vitest run --config vitest.media.config.ts"
	},
	"dependencies": {
		"@base-ui/react": "1.9.0",
		"@payloadcms/db-postgres": "3.91.0",
		"@payloadcms/email-nodemailer": "3.91.0",
		"@payloadcms/live-preview-react": "3.91.0",
		"@payloadcms/next": "3.91.0",
		"@payloadcms/richtext-lexical": "3.91.0",
		"@payloadcms/translations": "3.91.0",
		"@payloadcms/ui": "3.91.0",
		"graphql": "^16.14.2",
		"next": "16.4.2",
		"payload": "3.91.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sharp": "0.35.5"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.2",
		"@csstools/postcss-global-data": "4.0.0",
		"@playwright/test": "1.64.1",
		"@types/node": "^22.20.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"esbuild": "~0.28.2",
		"postcss": "8.5.23",
		"postcss-custom-media": "12.0.3",
		"stylelint": "17.16.0",
		"typescript": "^5",
		"vitest": "5.0.5"
	},
	"packageManager": "pnpm@10.12.4"
}
